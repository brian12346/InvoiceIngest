# InvoiceIngest — environment variables
# Copy this file to .env and fill in your values.
# Never commit .env to source control.

# QuickBooks Online API credentials
# Get these from https://developer.intuit.com → your app → Keys & OAuth
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REALM_ID=

# OAuth tokens (generated by running: node src/quickbooks.js --auth)
QBO_ACCESS_TOKEN=
QBO_REFRESH_TOKEN=

# Set to true while testing against QBO sandbox
QBO_SANDBOX=false
